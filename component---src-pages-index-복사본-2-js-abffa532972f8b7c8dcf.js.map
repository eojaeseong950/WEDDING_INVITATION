import React, { useEffect, useRef, useState } from "react";
import { Layout } from "antd";
import styled, { keyframes } from "styled-components";
import "react-image-gallery/styles/css/image-gallery.css";
import "antd/dist/antd.css";
import Gallery from "../components/gallery";
import Greeting from "../components/greeting";
import Title from "../components/title";
import "../styles/index.css";
import GroovePaper from "../assets/GroovePaper.png";
import Location from "../components/location";
import CongratulatoryMoney from "../components/congratulatoryMoney";
import Share from "../components/share";
import Quote from "../components/quote";
import Song from "../assets/song.mp3";
import AOS from "aos";
import "aos/dist/aos.css";

const { Footer } = Layout;

// 🎈 둥둥 뜨는 애니메이션
const float = keyframes`
  0% { transform: translateY(0px); }
  50% { transform: translateY(-6px); }
  100% { transform: translateY(0px); }
`;

// 💨 fade-out 애니메이션
const fadeOut = keyframes`
  from { opacity: 1; transform: scale(1); }
  to { opacity: 0; transform: scale(0.8); }
`;

const Wrapper = styled.div`
  background: #efebe9;
  background-image: url(${GroovePaper});
  width: 100%;
`;

const SoundButton = styled.button`
  position: fixed;
  top: 22px;
  right: 22px;
  background: rgba(70, 50, 40, 0.85);
  color: white;
  border: none;
  padding: 10px 14px;
  border-radius: 50px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  z-index: 1000;
  box-shadow: 0px 3px 6px rgba(0, 0, 0, 0.25);
  animation: ${float} 2.2s ease-in-out infinite;

  transition: all 0.3s ease;
  backdrop-filter: blur(4px);

  &:hover {
    background: rgba(50, 35, 25, 0.9);
    transform: scale(1.05);
  }

  &.fade-out {
    animation: ${fadeOut} 0.6s forwards;
  }
`;

const IndexPage = () => {
  const audioRef = useRef(null);
  const [isMuted, setIsMuted] = useState(true);
  const [isFading, setIsFading] = useState(false);

  // ✅ Kakao SDK + AOS 초기화
  useEffect(() => {
    const script = document.createElement("script");
    script.async = true;
    script.src = "https://developers.kakao.com/sdk/js/kakao.min.js";
    document.body.appendChild(script);

    AOS.init({ duration: 1500 });

    return () => {
      document.body.removeChild(script);
    };
  }, []);

  // ✅ 버튼 클릭 시 소리 켜기
  const handleUnmute = () => {
    if (audioRef.current) {
      audioRef.current.muted = false;
      audioRef.current
        .play()
        .then(() => {
          setIsFading(true);
          setTimeout(() => setIsMuted(false), 600);
        })
        .catch((e) => console.log("재생 불가:", e));
    }
  };

  return (
    <Wrapper>
      {/* 🎵 자동 재생 (무음 시작) */}
      <audio ref={audioRef} autoPlay loop muted playsInline>
        <source src={Song} type="audio/mp3" />
      </audio>

      {/* 메인 콘텐츠 */}
      <Title />
      <Greeting />
      <Location />
      <Quote />
      <Gallery />
      <Share />

      {/* 🔊 둥둥 떠다니는 미니 버튼 */}
      {isMuted && (
        <SoundButton
          className={isFading ? "fade-out" : ""}
          onClick={handleUnmute}
        >
          🔊 소리 켜기
        </SoundButton>
      )}

      {/* Footer */}
      <Footer
        style={{
          background: "#D7CCC8",
          backgroundImage: `url(${GroovePaper})`,
          opacity: 0.6,
          textAlign: "center",
          padding: "20px",
        }}
      >
        Copyright © 2025 EO JAESUNG
      </Footer>
    </Wrapper>
  );
};

export default IndexPage;
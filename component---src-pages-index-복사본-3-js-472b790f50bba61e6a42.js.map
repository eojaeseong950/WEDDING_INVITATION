import React, { useEffect, useRef, useState } from "react";
import { Layout } from "antd";
import styled, { keyframes } from "styled-components";
import "react-image-gallery/styles/css/image-gallery.css";
import "antd/dist/antd.css";
import Gallery from "../components/gallery";
import Greeting from "../components/greeting";
import Title from "../components/title";
import "../styles/index.css";
import GroovePaper from "../assets/GroovePaper.png";
import Location from "../components/location";
import CongratulatoryMoney from "../components/congratulatoryMoney";
import Share from "../components/share";
import Quote from "../components/quote";
import Song from "../assets/song.mp3";
import AOS from "aos";
import "aos/dist/aos.css";

const { Footer } = Layout;

// 🎈 버튼이 살짝 떠 있는 효과
const float = keyframes`
  0% { transform: translateY(0px); }
  50% { transform: translateY(-6px); }
  100% { transform: translateY(0px); }
`;

// 💞 버튼이 커졌다가 사라지는 로맨틱 페이드아웃
const romanticFadeOut = keyframes`
  0% { opacity: 1; transform: scale(1); }
  40% { transform: scale(1.1); }
  100% { opacity: 0; transform: scale(0.7); }
`;

// 🌸 메인 콘텐츠가 천천히 나타나는 페이드인
const fadeIn = keyframes`
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
`;

// 🎀 초기 분홍 배경
const InitialScreen = styled.div`
  position: fixed;
  inset: 0;
  background: linear-gradient(180deg, #f9d9dd 0%, #fceef0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  opacity: ${({ fadeOut }) => (fadeOut ? 0 : 1)};
  transition: opacity 1.5s ease;
  pointer-events: ${({ fadeOut }) => (fadeOut ? "none" : "auto")};
`;

// 💫 버튼 스타일
const SoundButton = styled.button`
  background: rgba(90, 60, 50, 0.85);
  color: white;
  border: none;
  padding: 16px 28px;
  border-radius: 50px;
  font-size: 17px;
  font-weight: 600;
  letter-spacing: 0.5px;
  cursor: pointer;
  box-shadow: 0px 5px 10px rgba(0, 0, 0, 0.3);
  animation: ${float} 2.4s ease-in-out infinite;
  transition: all 0.3s ease;
  backdrop-filter: blur(6px);

  &:hover {
    background: rgba(60, 40, 30, 0.9);
    transform: scale(1.05);
  }

  &.fade-out {
    animation: ${romanticFadeOut} 1s forwards;
  }
`;

// 🌷 콘텐츠 영역
const Wrapper = styled.div`
  background: #efebe9;
  background-image: url(${GroovePaper});
  width: 100%;
  min-height: 100vh;
  opacity: ${({ isVisible }) => (isVisible ? 1 : 0)};
  animation: ${({ isVisible }) => (isVisible ? fadeIn : "none")} 1.8s ease;
  transition: opacity 1.5s ease;
`;

const IndexPage = () => {
  const audioRef = useRef(null);
  const [showIntro, setShowIntro] = useState(true);
  const [fadeOutIntro, setFadeOutIntro] = useState(false);
  const [showContent, setShowContent] = useState(false);
  const [fadeButton, setFadeButton] = useState(false);

  useEffect(() => {
    const script = document.createElement("script");
    script.async = true;
    script.src = "https://developers.kakao.com/sdk/js/kakao.min.js";
    document.body.appendChild(script);
    AOS.init({ duration: 1500 });

    return () => {
      document.body.removeChild(script);
    };
  }, []);

  const handleUnmute = () => {
    if (audioRef.current) {
      audioRef.current
        .play()
        .then(() => {
          setFadeButton(true); // 버튼 확대-페이드 시작
          setTimeout(() => setFadeOutIntro(true), 600); // 배경 페이드아웃
          setTimeout(() => {
            setShowIntro(false);
            setShowContent(true);
          }, 1800); // 전체 화면 전환 완료
        })
        .catch((e) => console.log("재생 불가:", e));
    }
  };

  return (
    <>
      {/* 🌸 초기 분홍 화면 */}
      {showIntro && (
        <InitialScreen fadeOut={fadeOutIntro}>
          <SoundButton
            className={fadeButton ? "fade-out" : ""}
            onClick={handleUnmute}
          >
             Dear My Love 💖
          </SoundButton>
        </InitialScreen>
      )}

      {/* 🎵 음악: 클릭 후에만 재생됨 */}
      <audio ref={audioRef} loop playsInline>
        <source src={Song} type="audio/mp3" />
      </audio>

      {/* 메인 콘텐츠 */}
      <Wrapper isVisible={showContent}>
        <Title />
        <Greeting />
        <Location />
        <Quote />
        <Gallery />
        <Share />
        <Footer
          style={{
            background: "#D7CCC8",
            backgroundImage: `url(${GroovePaper})`,
            opacity: 0.6,
            textAlign: "center",
            padding: "20px",
          }}
        >
          Copyright © 2025 EO JAESUNG
        </Footer>
      </Wrapper>
    </>
  );
};

export default IndexPage;